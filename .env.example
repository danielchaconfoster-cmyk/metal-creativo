# ==============================================================================
# METAL CREATIVO CHILE - VARIABLES DE ENTORNO REQUERIDAS EN VERCEL
# ==============================================================================

# Acceso privado al panel y al simulador (tambien obligatorio en localhost).
# Genera una clave aleatoria unica de al menos 32 caracteres; recomendado: 32 bytes en hex.
# Guardala en un gestor de contrasenas y configura ADMIN_TOKEN solo en el servidor.
# Formato admitido: 32-512 caracteres ASCII visibles, sin espacios. Nunca NEXT_PUBLIC_*.
# Vacio o invalido: ambos accesos administrativos responden 503 (cerrados).
ADMIN_TOKEN=

# Identidad y acceso privado a estado de pedidos. Solo en backend.
SITE_URL=https://metalcreativo.cl
ORDER_ACCESS_SECRET=
# Desactivar el parseo automático para verificar firmas sobre bytes originales.
NODEJS_HELPERS=0

# Supabase Database & Auth (Cero Costo Tier)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_clave_secreta_service_role_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_publica_anon_aqui

# Mercado Pago Chile (Credenciales de Produccion o Sandbox)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu_access_token_aqui
MERCADOPAGO_PUBLIC_KEY=APP_USR-tu_public_key_aqui
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret_firmado_aqui
MERCADOPAGO_CLIENT_ID=tu_client_id_aqui
MERCADOPAGO_CLIENT_SECRET=tu_client_secret_aqui

# live o sandbox; no deducir el tipo de cuenta por el prefijo APP_USR.
MERCADOPAGO_MODE=live

# WhatsApp: configurar número real de ESTA marca; no activar con un número de prueba.
META_APP_SECRET=
META_ACCESS_TOKEN=
META_CAMPAIGN_ID=
META_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALLOW_TEST_NUMBER=false
# GEMINI_API_KEY es opcional. Sin clave se usa el motor local sin costo de IA.
GEMINI_API_KEY=
